{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "Consolidado": "Host=localhost;Port=5432;Database=consolidado_db;Username=consolidado;Password=consolidado"
  },

  "RabbitMq": {
    "Uri": "amqp://consolidado:consolidado@localhost:5672/",
    "NomeDaConexao": "verity-consolidado-worker"
  },

  "ConsumoDeLancamentosRegistrados": {
    "QuantidadeMaximaDeMensagensEmProcessamento": 20,
    "IntervaloEntreTentativasDeConexao": "00:00:05",
    "EsperaInicialAposFalhaTransitoria": "00:00:01",
    "EsperaMaximaAposFalhaTransitoria": "00:00:30"
  }
}
