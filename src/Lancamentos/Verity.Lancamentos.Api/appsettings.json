{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Lancamentos": "Host=localhost;Port=5432;Database=lancamentos_db;Username=lancamentos;Password=lancamentos"
  },

  "RabbitMq": {
    "Uri": "amqp://lancamentos:lancamentos@localhost:5672/",
    "NomeDaConexao": "verity-lancamentos-api",
    "TempoLimiteDeConexao": "00:00:05"
  },

  "Outbox": {
    "Habilitada": true,
    "TamanhoDoLote": 50,
    "IntervaloEntreCiclos": "00:00:01"
  },

  "LimiteDeRequisicoesPorComerciante": {
    "Habilitado": true,
    "LimiteDeRajada": 100,
    "RequisicoesPorPeriodo": 50,
    "Periodo": "00:00:01"
  },

  "Autenticacao": {
    "Emissor": "http://localhost:8081/realms/verity",
    "EnderecoDeMetadados": "http://localhost:8081/realms/verity/.well-known/openid-configuration",
    "Audiencia": "verity-api",
    "ExigirHttpsNosMetadados": true
  }
}
