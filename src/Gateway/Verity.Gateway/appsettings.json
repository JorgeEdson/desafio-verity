{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Gateway": {
    "TamanhoMaximoDoCorpoEmBytes": 65536
  },

  "ReverseProxy": {
    "Routes": {
      "lancamentos": {
        "ClusterId": "lancamentos",
        "Match": { "Path": "/lancamentos/{**restante}" }
      },
      "consolidado": {
        "ClusterId": "consolidado",
        "Match": { "Path": "/consolidado/{**restante}" }
      }
    },

    "Clusters": {
      "lancamentos": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "2" },
        "Destinations": {
          "lancamentos1": { "Address": "http://localhost:5101/" }
        }
      },

      "consolidado": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "2" },
        "Destinations": {
          "consolidado1": { "Address": "http://localhost:5201/" },
          "consolidado2": { "Address": "http://localhost:5202/" }
        }
      }
    }
  }
}
